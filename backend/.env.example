# Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_PATH=./data/lawvox.db
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Application Details
APP_NAME=LAWVOX
APP_ENV=development
DEBUG=true

# Authentication (used in later phases — do not commit real secrets)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional integrations (used in later phases)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
TTS_API_KEY=
